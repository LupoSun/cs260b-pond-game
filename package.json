{
  "name": "cs260b-pond-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comic-style multiplayer pond game: teams share one swimming creature, each phone paddles one limb",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "rehearse:load": "tsx scripts/loadRehearsal.ts",
    "tunnel:quick": "cloudflared tunnel --no-autoupdate --url http://127.0.0.1:3000"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "express": "4.21.2",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vitest": "3.0.7"
  }
}
