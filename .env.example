# Copy to .env and fill in real values. Never commit .env.

PORT=3000
HOST=127.0.0.1

# Required when NODE_ENV=production. Passcode for Mission Control (/control).
HOST_PASSCODE=change-me

# Public HTTPS URL shown on the join QR code (leave blank to use the browser origin).
PUBLIC_BASE_URL=

# Keep false for real sessions so synthetic test buttons stay hidden.
ENABLE_DEV_SIM=false
